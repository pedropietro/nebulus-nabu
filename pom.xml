<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.pedropietro</groupId>
    <artifactId>nebulus-nabu</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>nebulus-nabu</name>
    <description>Virtual IPFS: a Java port of Nebulus on top of the Nabu IPFS implementation</description>
    <url>https://github.com/pedropietro/nebulus-nabu</url>

    <!-- Metadata required by Maven Central -->
    <licenses>
        <license>
            <name>BSD-3-Clause</name>
            <url>https://opensource.org/licenses/BSD-3-Clause</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>pedropietro</id>
            <name>Pedro Pietroluongo</name>
            <url>https://github.com/pedropietro</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/pedropietro/nebulus-nabu.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/pedropietro/nebulus-nabu.git</developerConnection>
        <url>https://github.com/pedropietro/nebulus-nabu</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/pedropietro/nebulus-nabu/issues</url>
    </issueManagement>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <!-- Nabu from https://github.com/pedropietro/nabu, built by JitPack at this commit -->
        <nabu.groupId>com.github.pedropietro</nabu.groupId>
        <nabu.version>565204cd36</nabu.version>
        <junit.version>4.13.2</junit.version>
    </properties>

    <repositories>
        <!-- Nabu and its libp2p dependencies are distributed through JitPack -->
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
        <repository>
            <id>consensys</id>
            <url>https://artifacts.consensys.net/public/maven/maven/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>${nabu.groupId}</groupId>
            <artifactId>nabu</artifactId>
            <version>${nabu.version}</version>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
          Use a Nabu built from source and installed in the local Maven repository:
            git clone https://github.com/pedropietro/nabu && mvn -f nabu/pom.xml install -DskipTests
            mvn -Pnabu-local verify
        -->
        <profile>
            <id>nabu-local</id>
            <properties>
                <nabu.groupId>com.github.peergos</nabu.groupId>
                <nabu.version>v0.9.1</nabu.version>
            </properties>
        </profile>

        <!--
          Publishing to Maven Central (Central Portal). Kept in a profile so regular builds,
          CI and JitPack do not need a GPG key or the Central token.

            mvn -Prelease clean deploy

          Requires a server "central" with the Portal user token in ~/.m2/settings.xml and the
          GPG passphrase from gpg-agent or the MAVEN_GPG_PASSPHRASE environment variable.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <configuration>
                            <doclint>all,-missing</doclint>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <configuration>
                            <!-- Passphrase only from gpg-agent or MAVEN_GPG_PASSPHRASE, never from the POM or settings.xml -->
                            <bestPractices>true</bestPractices>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!-- Upload and validate; the release is confirmed manually in the Portal -->
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <compilerArgs>
                        <arg>-Xlint:all,-processing,-classfile</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <redirectTestOutputToFile>true</redirectTestOutputToFile>
                    <trimStackTrace>false</trimStackTrace>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
